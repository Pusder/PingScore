<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/score_bg"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/land_control_rail"
        android:layout_width="224dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_control_rail"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/history_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="历史记录"
                android:src="@drawable/ic_history"
                app:tint="@color/score_ink" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="乒乓球计分器"
                android:textColor="@color/score_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/global_settings_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="全局设置"
                android:src="@drawable/ic_settings"
                android:tint="@color/score_ink"
                android:tintMode="src_in" />
        </LinearLayout>

        <TextView
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_start_button"
            android:gravity="center"
            android:text="开始比赛"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/match_progress"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_round_pill"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="正规赛 · BO3"
            android:textColor="@color/score_ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/set_tabs_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingBottom="4dp"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/team_queue_button"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_set_tab"
            android:gravity="center"
            android:text="待赛  + 添加对局"
            android:textColor="@color/score_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mode_info_button"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_set_tab"
            android:gravity="center"
            android:text="规则说明"
            android:textColor="@color/score_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/land_action_panel"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/land_settings_button"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_settings_black"
                android:gravity="center"
                android:text="设定"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/land_pause_button"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pause_red"
                android:gravity="center"
                android:text="暂停"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/land_serve_button"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_serve_green"
                android:gravity="center"
                android:text="换发"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/scoreboard_fragment_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_weight="1" />
</LinearLayout>
